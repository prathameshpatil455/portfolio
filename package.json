{
  "name": "dark-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint:strict": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format:check": "prettier --check src/**/*.{ts,tsx,js,jsx,json,css,md}",
    "format:fix": "prettier --write src/**/*.{ts,tsx,js,jsx,json,css,md}",
    "check-unused": "knip --include files,dependencies --no-config-hints",
    "bundle-size": "npx vite-bundle-analyzer",
    "clean": "pnpm run lint:fix && pnpm run format:fix"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.0.2",
    "@reduxjs/toolkit": "^2.2.1",
    "@splinetool/react-spline": "^4.0.0",
    "axios": "^1.13.6",
    "formik": "^2.4.6",
    "framer-motion": "^11.0.5",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^9.16.0",
    "react-redux": "^9.1.0",
    "react-router-dom": "^7.13.1",
    "react-toastify": "^11.0.5",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "postcss": "^8.4.35",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.57.1",
    "knip": "^5.70.0",
    "vite": "^5.4.21",
    "vite-bundle-analyzer": "^1.2.1"
  },
  "pnpm": {
    "overrides": {
      "glob": ">=10.5.0",
      "rollup": ">=4.59.0",
      "esbuild": ">=0.25.0",
      "lodash": ">=4.17.23",
      "lodash-es": ">=4.17.23",
      "minimatch": ">=9.0.7",
      "flatted": ">=3.4.2",
      "js-yaml": ">=4.1.1",
      "ajv": ">=6.14.0"
    }
  }
}
